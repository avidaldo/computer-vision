# Copy to .env to override any default. Relative paths are resolved from this folder.

# Image checked by face_auth.py when no image is given on the command line
IMAGE_PATH=../resources/images/scene1.jpg

# Persistent ChromaDB folder and collection (created by enroll.py)
DB_PATH=../artifacts/face_auth_db
COLLECTION_NAME=enrolled_faces

# Minimum mean brightness (0-255)
MIN_BRIGHTNESS=40.0

# Minimum sharpness (variance of the Laplacian)
MIN_SHARPNESS=100.0

# Minimum cosine similarity (1 - distance) to grant access
VERIFICATION_THRESHOLD=0.80

# YOLO26 weights (downloaded on first use) and CLIP model name
YOLO_MODEL_PATH=../resources/models/yolo26n.pt
CLIP_MODEL_NAME=clip-ViT-B-32
